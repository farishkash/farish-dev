---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BLOG_CATEGORIES } from '../lib/categories';
import { formatPostDate, newestFirst, postUrl, readingTime } from '../lib/blog';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(newestFirst).slice(0, 3);
---

<BaseLayout description="Farish Kashefinejad writes about AI, software, technical education, learning, and the work of turning new technology into something useful.">
  <section class="hero blog-hero">
    <p class="eyebrow">AI · Software · Education · Work</p>
    <h1>Thoughts on technology, learning, and what happens when the hype meets real work.</h1>
    <p class="lede">I’m Farish Kashefinejad. This is where I write about what I’m learning, questioning, building, and occasionally arguing about.</p>
    <div class="actions">
      <a class="button primary" href="#latest">Latest posts</a>
      <a class="button" href="/about">About me</a>
    </div>
  </section>

  <section class="section home-latest" id="latest">
    <div class="section-heading home-section-heading">
      <div>
        <p class="eyebrow">Latest writing</p>
        <h2>Recent thoughts</h2>
      </div>
      <p>No content treadmill. I write when there’s something worth saying: a practical lesson, an argument, a build log, or an idea I’m still working through.</p>
    </div>

    <div class="post-list home-posts">
      {latestPosts.map((post) => (
        <a class="post-card home-post-card" href={postUrl(post)}>
          <div>
            <div class="post-kicker">
              <span>{post.data.category}</span>
              <span>·</span>
              <span>{formatPostDate(post.data.published)}</span>
              <span>·</span>
              <span>{readingTime(post.body)} min read</span>
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <span class="post-tags">
                {post.data.tags.map((tag, index) => (
                  <>{index > 0 && ' · '}<span>{tag}</span></>
                ))}
              </span>
            )}
          </div>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>

    <a class="text-link" href="/writing">All posts →</a>
  </section>

  <section class="section home-topics">
    <div class="section-heading home-section-heading">
      <div>
        <p class="eyebrow">Categories</p>
        <h2>Things I keep coming back to.</h2>
      </div>
      <p>These are the broad lanes for the blog. Individual posts can still wander, and tags handle the more specific subjects underneath them.</p>
    </div>

    <div class="topic-grid">
      {BLOG_CATEGORIES.map((category, index) => (
        <a class="topic-card" href={`/writing/categories/${category.slug}`}>
          <span class="topic-number">{String(index + 1).padStart(2, '0')}</span>
          <h3>{category.name}</h3>
          <p>{category.description}</p>
          <span class="topic-link">Browse posts →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section home-about">
    <div class="about-panel">
      <div>
        <p class="eyebrow">About Farish</p>
        <h2>The blog gets the thoughts. The résumé gets the bullet points.</h2>
      </div>
      <div class="about-panel-copy">
        <p>My work sits across AI, data science, product and curriculum strategy, and technical education. This site gives me room to explore the parts that don’t fit neatly into a job description.</p>
        <div class="about-links">
          <a class="text-link" href="/about">More about me →</a>
          <a class="text-link" href="/work">Professional work →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
