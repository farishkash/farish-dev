---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPostDate, newestFirst, postUrl, readingTime } from '../lib/blog';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(newestFirst).slice(0, 3);
---

<BaseLayout description="Farish Kashefinejad writes about AI, software, technical education, EdTech, learning, and the work of turning new technology into something useful.">
  <section class="hero blog-hero">
    <p class="eyebrow">AI · Software · EdTech · Work</p>
    <h1>Thoughts on technology, learning, and what happens when the hype meets real work.</h1>
    <p class="lede">I’m Farish Kashefinejad. I work across AI, data science, product and curriculum strategy, and technical education. This is where I write down the things I’m learning, questioning, building, and occasionally arguing about.</p>
    <div class="actions">
      <a class="button primary" href="/writing">Read the blog</a>
      <a class="button" href="/about">About me</a>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Latest writing</p>
        <h2>Recent thoughts</h2>
      </div>
      <p>No content treadmill here. I write when there’s something worth saying, whether that’s a practical lesson, an argument, a build log, or an idea I’m still working through.</p>
    </div>

    <div class="post-list home-posts">
      {latestPosts.map((post) => (
        <a class="post-card" href={postUrl(post)}>
          <div>
            <div class="post-kicker">
              <span>{formatPostDate(post.data.published)}</span>
              <span>·</span>
              <span>{readingTime(post.body)} min read</span>
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>

    <a class="text-link" href="/writing">All writing →</a>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">What I work on</p>
        <h2>Strategy with enough technical depth to ship.</h2>
      </div>
      <p>My work tends to sit between engineers, subject-matter experts, product teams, customers, and learners. I’m most useful when the technology is complicated, the audience is demanding, and the answer needs to work outside a slide deck.</p>
    </div>
    <div class="grid-3">
      <article class="card">
        <p class="number">01</p>
        <h3>AI & Data Science</h3>
        <p>Applied AI, agentic systems, technical content, hands-on learning, and the practical realities of adopting new tools.</p>
      </article>
      <article class="card">
        <p class="number">02</p>
        <h3>Product & Curriculum Strategy</h3>
        <p>Turning market needs and technical requirements into coherent portfolios, courses, labs, and product experiences.</p>
      </article>
      <article class="card">
        <p class="number">03</p>
        <h3>Enterprise Enablement</h3>
        <p>Helping technical and business audiences move from “we should use AI” to useful workflows, capability, and adoption.</p>
      </article>
    </div>
  </section>
</BaseLayout>
