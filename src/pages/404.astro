---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you requested could not be found.">
  <section class="page page-narrow">
    <p class="eyebrow">404</p>
    <h1>This page wandered off.</h1>
    <p class="lede">The link may be old, the page may have moved, or I may have changed my mind about it.</p>
    <div class="actions"><a class="button primary" href="/">Go home</a></div>
  </section>
</BaseLayout>
