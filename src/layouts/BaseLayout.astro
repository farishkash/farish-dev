---
import '../styles/global.css';
import '../styles/categories.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  tags?: string[];
}

const {
  title = 'Farish Kashefinejad',
  description = 'AI, data science, product strategy, enterprise enablement, and technical education.',
  type = 'website',
  publishedTime,
  updatedTime,
  tags = [],
} = Astro.props;

const pageTitle = title === 'Farish Kashefinejad' ? title : `${title} | Farish Kashefinejad`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
const nav = [
  { href: '/', label: 'Home' },
  { href: '/writing', label: 'Blog' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c1118" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="farish.dev RSS" href={new URL('/rss.xml', Astro.site)} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="farish.dev" />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Farish Kashefinejad home">farish<span>.dev</span></a>
        <nav aria-label="Primary navigation">
          {nav.map((item) => {
            const active = Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href));
            return (
              <a
                class:list={[{ active }]}
                href={item.href}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
      </header>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <p>© {year} Farish Kashefinejad</p>
        <nav aria-label="Footer navigation">
          <a href="/accessibility">Accessibility</a>
          <a href="/rss.xml">RSS</a>
          <a href="https://www.linkedin.com/in/farishkash/" rel="me">LinkedIn</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
